# macOS
.DS_Store

# ESP-IDF build artifacts (regenerated by idf.py)
firmware/build/
firmware/managed_components/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/.cache/

# Swift Package Manager build artifacts
macos-helper/.build/
macos-helper/.swiftpm/

# Local docx QA working directory (render outputs, profiles)
.docx_qa/

# Python
__pycache__/
*.pyc

# Machine-specific ESP-IDF installer paths
eim_config.local.toml

# Code signing artifacts (never commit certificates or provisioning profiles)
*.p12
*.pfx
*.cer
*.mobileprovision

# Logs
*.log
